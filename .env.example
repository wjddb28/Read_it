# 이 파일을 복사해서 .env 로 만들고 값을 채우세요. (.env 는 git에 올라가지 않습니다)

# 도서관 정보나루 API 키 (fetch_books.py 실행하는 사람만 필요)
LIBRARY_API_KEY=

# 로컬 MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=read_it_db

# ChromaDB 저장 위치 (선택). 비워두면 프로젝트의 chroma_data/,
# 프로젝트 경로에 한글이 있으면 홈 폴더의 .readit/chroma_data 를 씁니다. (한글 경로는 ChromaDB가 못 읽음)
CHROMA_DIR=

# Gemini
GEMINI_API_KEY=
